quantile(mtcars$qsec)
data[data > highLimit] <- median(data)
outliersReplace <- function(data, lowLimit, highLimit){
data[data < lowLimit] <- mean(data)
data[data > highLimit] <- median(data)
data     #devolvemos el dato
}
mtcars2<-outliersReplace(mtcars,14.5,22)
summary(mtcars$qsec)
quantile(mtcars$qsec)
boxplot(mtcars$qsec)
#Cajas y Bigotes
